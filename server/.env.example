# ── SERVER ──────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:5173

# ── MYSQL (XAMPP local defaults) ───────────────────────────
# XAMPP default: host=localhost, user=root, password="" (empty), port=3306
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=atelier_db

# ── AUTH ────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_before_production

# ── JAZZCASH (Mobile Wallet / Page Redirect API) ───────────
# Get these from JazzCash Merchant Sandbox: https://sandbox.jazzcash.com.pk
# Sandbox defaults below are JazzCash's publicly published test merchant values.
JAZZCASH_MERCHANT_ID=MC12345
JAZZCASH_PASSWORD=xxxxxxxx
JAZZCASH_INTEGRITY_SALT=xxxxxxxxxx
JAZZCASH_RETURN_URL=http://localhost:4000/api/payments/jazzcash/callback
JAZZCASH_ENV=sandbox
# sandbox URL vs production URL is chosen automatically based on JAZZCASH_ENV

# ── EASYPAISA (Mobile Account API) ─────────────────────────
# Get these from EasyPaisa Merchant Portal: https://easypaisa.com.pk
EASYPAISA_STORE_ID=your_store_id
EASYPAISA_HASH_KEY=your_hash_key
EASYPAISA_ACCOUNT_NUM=your_account_number
EASYPAISA_RETURN_URL=http://localhost:4000/api/payments/easypaisa/callback
EASYPAISA_ENV=sandbox
